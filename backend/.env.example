# ─── Core App (Phase 1 keys) ──────────────────────────────────────────────────
APP_ENV=development
APP_KEY=change_me_to_a_random_32_plus_char_secret

# Keep NODE_ENV for tooling compatibility
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=fbr_invoicing
DB_USER=postgres

# Phase 1 key name
DB_PASS=postgres

# Backward-compatible alias currently used by some tooling
DB_PASSWORD=postgres

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_minimum_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Encryption (AES-256-GCM) ─────────────────────────────────────────────────
# 32-byte hex string (64 hex characters)
ENCRYPTION_KEY=your_32_byte_hex_string_for_aes256_encryption_here

# ─── FBR API ──────────────────────────────────────────────────────────────────
# Phase 1 key name
FBR_API_URL=https://gw.fbr.gov.pk/imssandbox/api/Live/

# Current project-specific keys
FBR_ENV=sandbox
FBR_SANDBOX_URL=https://gw.fbr.gov.pk/imssandbox/api/Live/
FBR_PROD_URL=https://gw.fbr.gov.pk/imsnew/api/Live/

# ─── Mail ─────────────────────────────────────────────────────────────────────
# Phase 1 key names
MAIL_HOST=smtp.gmail.com
MAIL_USER=your@email.com
MAIL_PASS=your_app_password

# Current project-specific aliases
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password

# ─── Frontend (CORS) ──────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
